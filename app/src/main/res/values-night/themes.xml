<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 
        MediScan uses a consistent brand-focused UI. 
        Dark mode themes are derived from the base style.
    -->
    <style name="Theme.MediScan" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/hdr</item>
        <item name="colorPrimaryVariant">@color/sub</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/accent</item>

        <!-- UI Colors (Dark variant) -->
        <item name="android:windowBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>

        <!-- Status & Nav Bar -->
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#121212</item>

        <!-- Window features -->
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
