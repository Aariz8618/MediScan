<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- Fragment container fills all space above the bottom nav -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:elevation="8dp">

        <!-- Home tab -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Home" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="@color/hdr"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />

            <!-- Active indicator pill -->
            <View
                android:id="@+id/navHomePip"
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_nav_pip"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Reports tab -->
        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navReportsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_reports"
                android:contentDescription="Reports" />

            <TextView
                android:id="@+id/navReportsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reports"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:layout_marginTop="3dp" />

            <View
                android:id="@+id/navReportsPip"
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_nav_pip"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Analyze tab -->
        <LinearLayout
            android:id="@+id/navAnalyze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navAnalyzeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_analyze"
                android:contentDescription="Analyze" />

            <TextView
                android:id="@+id/navAnalyzeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyze"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:layout_marginTop="3dp" />

            <View
                android:id="@+id/navAnalyzePip"
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_nav_pip"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Profile tab -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <ImageView
                android:id="@+id/navProfileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile" />

            <TextView
                android:id="@+id/navProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="10sp"
                android:textColor="@color/muted"
                android:layout_marginTop="3dp" />

            <View
                android:id="@+id/navProfilePip"
                android:layout_width="32dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_nav_pip"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
