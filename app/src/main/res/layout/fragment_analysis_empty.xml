<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hdr"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="4dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Analysis" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI-powered medical insights" android:textColor="#B2FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔬" android:textSize="56sp" android:layout_gravity="center" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No report selected" android:textColor="@color/hdr" android:textSize="18sp" android:textStyle="bold" android:layout_gravity="center" android:layout_marginBottom="10dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upload a report or choose from your history to get AI-powered insights and a detailed analysis." android:textColor="@color/muted" android:textSize="13sp" android:gravity="center" android:lineSpacingMultiplier="1.6" android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnUploadNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Upload New Report"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_share_btn"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnViewExisting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="View Existing Reports"
            android:textColor="@color/hdr"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_btn" />
    </LinearLayout>
</LinearLayout>